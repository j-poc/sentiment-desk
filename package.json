{
  "name": "sentiment-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-source company research desk with bounded OpenAI GPT-6 Luna categorical classification, preserved historical Jev scores, and source-linked evidence.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external",
    "start": "node dist/server/index.js",
    "verify:jev-live": "tsx scripts/verify-live-jev.ts",
    "verify:sec-filings-hub": "tsx scripts/verify-sec-filings-hub.ts",
    "verify:offline-startup": "npm run build && tsx scripts/verify-offline-startup.ts",
    "verify:retry-browser": "tsx scripts/verify-retry-browser.ts",
    "verify:jev-sanity": "tsx scripts/verify-jev-sanity.ts",
    "verify:jev-real-source-evidence": "tsx scripts/verify-jev-real-source-evidence.ts",
    "verify:local-read-capacity": "npm run build && python3 scripts/verify-local-read-capacity.py",
    "evaluate:jev-labels": "tsx scripts/evaluate-jev-labels.ts",
    "typecheck": "tsc --noEmit",
    "verify:cloud-core": "node scripts/verify-cloud-core.mjs",
    "evaluate:golden": "tsx scripts/evaluate-investor-golden.ts",
    "test": "vitest run",
    "evaluate:luna-labels": "tsx scripts/evaluate-luna-labels.ts",
    "evaluate:luna-public-benchmark": "tsx scripts/luna-public-benchmark.ts"
  },
  "dependencies": {
    "@dcc/sec-client": "file:vendor/dcc-sec-client-0.1.1.tgz",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^1.14.0",
    "@napi-rs/keyring": "^2.1.0",
    "@supabase/supabase-js": "^2.117.3",
    "fast-xml-parser": "^5.2.0",
    "hono": "^4.7.0",
    "jose": "^6.2.12",
    "lightweight-charts": "^5.2.1",
    "lossless-json": "^4.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
