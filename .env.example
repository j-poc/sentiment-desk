# Sentiment Desk local-first configuration.
# Copy to .env only when you need to override these defaults. .env is gitignored.

# --- App surface -------------------------------------------------------------
# Local runs open the complete research desk. Set VITE_APP_MODE=cloud only for
# a separately provisioned hosted deployment; end users never configure it.
VITE_APP_MODE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# These belong in Supabase Edge Function secrets, never in Vercel/browser env:
# Set SEC_USER_AGENT only when you can provide a real operator/product identifier and contact email.
# SEC_DIRECTORY_SOURCE_ENABLED=false
# SEC_COMPANY_DATA_ENABLED=false
# APP_ALLOWED_ORIGINS=https://your-deployment.example

# --- Legacy ChatGPT-plan classifier -----------------------------------------
# This separate route uses Sign in with ChatGPT. Local BYOK source assessment
# keys are entered under Model API Keys and stored in the OS credential store.
CLASSIFICATION_PROVIDER=openai_luna
# Legacy automatic ChatGPT-plan classification is limited to these collectors.
# Local BYOK classifications still require a per-source confirmation.
OPENAI_ALLOWED_COLLECTORS=google_news_rss,yahoo_finance_rss
# Finite local limits. ChatGPT plan usage/credits are managed by OpenAI and are
# not visible to this app; no API-dollar estimate is applied to this route.
CHATGPT_PLAN_MAX_REQUESTS_PER_DAY=100
CHATGPT_PLAN_MAX_REQUEST_BYTES_PER_DAY=1638400
# Optional exact loopback origin for a separate local browser UI. Defaults to
# the local API origin; the authorization callback always remains on the API.
# CHATGPT_PLAN_LOCAL_ORIGIN=http://127.0.0.1:5173

# CLASSIFICATION_PROVIDER=typesafe remains rejected for the legacy classifier.
# The separate TypeSafe Jev BYOK workflow accepts a user key and keeps results
# in its own source-level history.

# --- Sources -----------------------------------------------------------------
# A local desk can load official SEC issuer, filing, and CompanyFacts data
# immediately. Model processing remains a separate user-confirmed action.
EXTERNAL_REQUESTS_ENABLED=false
EXTERNAL_SOURCE_COLLECTORS=sec_edgar,sec_company_facts
SOURCE_RIGHTS_APPROVED_COLLECTORS=sec_edgar,sec_company_facts

# Selected-company facts are on demand. SEC submissions polling is bounded by
# POLL_SEC_SECONDS and the app's storage-capacity checks.
# The zero-ticker Recent Filings page uses a Desk-specific descriptor for a
# trusted local Public Data Hub process. Add
# sec_latest_filings_8k and nasdaq_symbol_directories to both lists to permit
# its explicit activation. The Hub enforces a 15-minute minimum cadence and
# display-only source policy; Nasdaq directories are checked only on activation.
# Desk reads one private installation descriptor; it never falls back to the shared Hub locator.
# Defaults to ~/.codex/references/sentiment-desk-public-data-hub-installation.json.
# Set this only to an absolute path for a different Desk-owned descriptor.
DESK_HUB_INSTALLATION_FILE=
# Required for SEC requests. Keep blank until you can provide a real
# operator/product identifier and contact email; without it SEC calls are off.
SEC_USER_AGENT=
POLL_SEC_SECONDS=90

# Optional. Finnhub free tier (free key at finnhub.io): per-symbol news,
# EPS surprises vs consensus, and upcoming earnings dates. Add finnhub to the
# external source allowlist before it can make requests.
FINNHUB_API_KEY=
POLL_FINNHUB_SECONDS=120

# Optional. Reddit free OAuth app (create a "script" app at
# reddit.com/prefs/apps): adds the social tier via public search. Add reddit to
# the external source allowlist before it can make requests.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
POLL_REDDIT_SECONDS=180

# Optional. Add x to the external source allowlist to enable recent search.
X_BEARER_TOKEN=

# --- Market data -------------------------------------------------------------
# Yahoo Finance endpoints require yahoo_quote and/or yahoo_chart in the
# external source allowlist. Quote poll cadence and context indices.
POLL_QUOTES_SECONDS=90
# Comma-separated context tickers shown on the tape (never scored).
INDICES=SPY,QQQ,^VIX

# --- Alerts ------------------------------------------------------------------
# Optional webhook (Discord/Slack-style JSON body) pinged when a fresh event
# scores above the thresholds. This is the speed advantage off-screen.
ALERT_WEBHOOK_URL=
ALERT_EVENT_SCORE=65
ALERT_IMPACT=55
ALERT_FRESH_MINUTES=15

# --- Operation ---------------------------------------------------------------
# The local defaults above permit official SEC retrieval. Other external
# collectors remain disabled unless separately allowlisted and approved.
# The legacy ChatGPT-plan classifier also requires an account connection and
# finite local request and byte limits. BYOK calls use their selected provider
# key and the same local request gate; provider account quotas remain external.
PORT=8787
# SQLite file. Default ./data/desk.db
DB_PATH=
# Local SQLite safety limits, in bytes. New acquisition/classification pauses
# before the database reaches its ceiling and the minimum free-space reserve.
# Existing saved-data reads remain available in read-only capacity mode.
DESK_DB_MAX_BYTES=2147483648
DESK_DB_FAMILY_MAX_BYTES=5368709120
DESK_DISK_MIN_FREE_BYTES=1073741824
DESK_STORAGE_WRITE_HEADROOM_BYTES=134217728
# Watchlist config. Default ./config/companies.json
COMPANIES_PATH=
# Poll cadence in seconds.
POLL_RSS_SECONDS=180
RSS_CONCURRENCY=2
POLL_X_SECONDS=180
# Concurrent new Luna classifications.
SCORE_CONCURRENCY=6
