# Sentiment Desk configuration.
# Copy to .env and fill in. .env is gitignored and loaded automatically.

# --- Jev (TypeSafe AI) -------------------------------------------------------
# Required for live scoring. Without a key, real news and market data still
# load and mentions stay pending. DEMO=1 is an optional synthetic sentiment
# path for trying the interface; it is not the default or a live-data substitute.
TYPESAFE_API_KEY=
# Defaults; override only for tests or a self-hosted proxy.
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# --- Sources -----------------------------------------------------------------
# SEC fair-access requires a User-Agent that identifies you, with contact info.
# Set a user agent with your contact details (e.g. "Name email@example.com").
# The app has a generic fallback for local trials.
SEC_USER_AGENT=
POLL_SEC_SECONDS=90

# Optional. Finnhub free tier (free key at finnhub.io): per-symbol news,
# EPS surprises vs consensus, and upcoming earnings dates.
FINNHUB_API_KEY=
POLL_FINNHUB_SECONDS=120

# Optional. Reddit free OAuth app (create a "script" app at
# reddit.com/prefs/apps): adds the social tier via public search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
POLL_REDDIT_SECONDS=180

# Optional. Enables the X (Twitter) recent-search source per company.
X_BEARER_TOKEN=

# --- Market data -------------------------------------------------------------
# Yahoo Finance chart endpoint (no key). Quote poll cadence and context indices.
POLL_QUOTES_SECONDS=45
# Comma-separated context tickers shown on the tape (never scored).
INDICES=SPY,QQQ,^VIX

# --- Alerts ------------------------------------------------------------------
# Optional webhook (Discord/Slack-style JSON body) pinged when a fresh event
# scores above the thresholds. This is the speed advantage off-screen.
ALERT_WEBHOOK_URL=
ALERT_EVENT_SCORE=65
ALERT_IMPACT=55
ALERT_FRESH_MINUTES=15

# --- Operation ---------------------------------------------------------------
PORT=8787
# SQLite file. Default ./data/desk.db
DB_PATH=
# Watchlist config. Default ./config/companies.json
COMPANIES_PATH=
# Poll cadence in seconds.
POLL_RSS_SECONDS=30
POLL_X_SECONDS=180
# Scoring concurrency toward Jev.
SCORE_CONCURRENCY=6

# --- Demo --------------------------------------------------------------------
# Optional interface exercise. DEMO=1 makes sentiment synthetic and displays a
# DEMO badge; news collectors are disabled, while market quotes remain live.
DEMO=
