# Sentiment Desk configuration.
# Copy to .env and fill in. .env is gitignored and loaded automatically.

# --- Jev (TypeSafe AI) -------------------------------------------------------
# Required for live scoring. Resolution order: this file, then ~/.newsjack/.env
# (shared with the newsjack CLI). Without a key, ingestion runs and mentions
# stay pending; with DEMO=1 the synthetic generator is used instead.
TYPESAFE_API_KEY=
# Defaults; override only for tests or a self-hosted proxy.
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# --- Sources -----------------------------------------------------------------
# SEC fair-access requires a User-Agent that identifies you, with contact info.
# Set it (e.g. "Jurgis Doe jurgis@example.com") to enable EDGAR 8-K ingestion.
SEC_USER_AGENT=
POLL_SEC_SECONDS=90

# Optional. Finnhub free tier (free key at finnhub.io): per-symbol news,
# EPS surprises vs consensus, and upcoming earnings dates.
FINNHUB_API_KEY=
POLL_FINNHUB_SECONDS=120

# Optional. Reddit free OAuth app (create a "script" app at
# reddit.com/prefs/apps): adds the social tier via public search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
POLL_REDDIT_SECONDS=180

# Optional. Enables the X (Twitter) recent-search source per company.
X_BEARER_TOKEN=

# --- Market data -------------------------------------------------------------
# Yahoo Finance chart endpoint (no key). Quote poll cadence and context indices.
POLL_QUOTES_SECONDS=30
# Comma-separated context tickers shown on the tape (never scored).
INDICES=SPY,QQQ,^VIX

# --- Operation ---------------------------------------------------------------
PORT=8787
# SQLite file. Default ./data/desk.db
DB_PATH=
# Watchlist config. Default ./config/companies.json
COMPANIES_PATH=
# Poll cadence in seconds.
POLL_RSS_SECONDS=60
POLL_X_SECONDS=180
# Scoring concurrency toward Jev.
SCORE_CONCURRENCY=6

# --- Demo --------------------------------------------------------------------
# DEMO=1 generates synthetic mentions and scores them with a deterministic
# stub, so the dashboard is fully alive without any API key. The UI shows a
# DEMO badge. Never set in production.
DEMO=
