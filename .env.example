# Sentiment Desk configuration.
# Copy to .env and fill in. .env is gitignored and loaded automatically.

# --- Classification provider ------------------------------------------------
# Categorical Luna output is separate from immutable Jev probability scores.
CLASSIFICATION_PROVIDER=openai_luna
OPENAI_API_KEY=
OPENAI_ACCOUNT_USE_APPROVED=false
OPENAI_ALLOWED_COLLECTORS=
# Every finite cap defaults to zero; OpenAI dispatch stays disabled until all
# three are explicitly positive, alongside the global request and rights gates.
OPENAI_MAX_REQUESTS_PER_DAY=0
OPENAI_MAX_REQUEST_BYTES_PER_DAY=0
OPENAI_MAX_DAILY_COST_USD=0

# Historical Jev results remain readable. No Jev credential is read or used
# for new classifications; CLASSIFICATION_PROVIDER=typesafe is rejected.

# --- Sources -----------------------------------------------------------------
# External requests require EXTERNAL_REQUESTS_ENABLED=true, a per-source
# request allowlist, and a separate source-use approval list. Approval flags
# are operator attestations, not independent evidence of rights.
EXTERNAL_SOURCE_COLLECTORS=
SOURCE_RIGHTS_APPROVED_COLLECTORS=

# SEC access is disabled until a descriptive User-Agent includes contact info.
# Add sec_edgar to EXTERNAL_SOURCE_COLLECTORS and use a descriptive User-Agent.
# Example: "Research Desk name@example.com".
SEC_USER_AGENT=
POLL_SEC_SECONDS=90

# Optional. Finnhub free tier (free key at finnhub.io): per-symbol news,
# EPS surprises vs consensus, and upcoming earnings dates. Add finnhub to the
# external source allowlist before it can make requests.
FINNHUB_API_KEY=
POLL_FINNHUB_SECONDS=120

# Optional. Reddit free OAuth app (create a "script" app at
# reddit.com/prefs/apps): adds the social tier via public search. Add reddit to
# the external source allowlist before it can make requests.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
POLL_REDDIT_SECONDS=180

# Optional. Add x to the external source allowlist to enable recent search.
X_BEARER_TOKEN=

# --- Market data -------------------------------------------------------------
# Yahoo Finance endpoints require yahoo_quote and/or yahoo_chart in the
# external source allowlist. Quote poll cadence and context indices.
POLL_QUOTES_SECONDS=90
# Comma-separated context tickers shown on the tape (never scored).
INDICES=SPY,QQQ,^VIX

# --- Alerts ------------------------------------------------------------------
# Optional webhook (Discord/Slack-style JSON body) pinged when a fresh event
# scores above the thresholds. This is the speed advantage off-screen.
ALERT_WEBHOOK_URL=
ALERT_EVENT_SCORE=65
ALERT_IMPACT=55
ALERT_FRESH_MINUTES=15

# --- Operation ---------------------------------------------------------------
# All external requests are paused unless explicitly enabled.
# Luna also requires approved account use and finite request, byte and USD caps.
EXTERNAL_REQUESTS_ENABLED=false
PORT=8787
# SQLite file. Default ./data/desk.db
DB_PATH=
# Local SQLite safety limits, in bytes. New acquisition/classification pauses
# before the database reaches its ceiling and the minimum free-space reserve.
# Existing saved-data reads remain available in read-only capacity mode.
DESK_DB_MAX_BYTES=2147483648
DESK_DB_FAMILY_MAX_BYTES=5368709120
DESK_DISK_MIN_FREE_BYTES=1073741824
DESK_STORAGE_WRITE_HEADROOM_BYTES=134217728
# Watchlist config. Default ./config/companies.json
COMPANIES_PATH=
# Poll cadence in seconds.
POLL_RSS_SECONDS=180
RSS_CONCURRENCY=2
POLL_X_SECONDS=180
# Concurrent new Luna classifications.
SCORE_CONCURRENCY=6
